{
  "title": "Core Bank Microservices Overview",
  "tags": ["core-bank", "microservices"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Account Service Up",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "up{job='account-service'}",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Authentication Service Up",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "up{job='authentication-service'}",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Customer Service Up",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "up{job='customer-service'}",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Transaction Service Up",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "up{job='transaction-service'}",
        "refId": "A"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      }
    },
    {
      "type": "graph",
      "title": "Account Service Requests",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum(rate(http_requests_total{job='account-service'}[5m]))",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"unit": "req/s"}, "overrides": []}
    },
    {
      "type": "graph",
      "title": "Authentication Service Requests",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum(rate(http_requests_total{job='authentication-service'}[5m]))",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"unit": "req/s"}, "overrides": []}
    },
    {
      "type": "graph",
      "title": "Customer Service Requests",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum(rate(http_requests_total{job='customer-service'}[5m]))",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"unit": "req/s"}, "overrides": []}
    },
    {
      "type": "graph",
      "title": "Transaction Service Requests",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum(rate(http_requests_total{job='transaction-service'}[5m]))",
        "refId": "A"
      }],
      "fieldConfig": {"defaults": {"unit": "req/s"}, "overrides": []}
    }
  ]
